# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Runtime data (memory, logs, databases — never committed)
data/**
!data/**/
!data/**/.gitkeep
# Exception: the curriculum is authored, tiny, and rebuild-critical → versioned
!data/corpus/
!data/corpus/*.txt

# Local env overrides
.env

# Frontend (React + TypeScript, Vite)
web/node_modules/
web/dist/
web/*.tsbuildinfo

# Stray runtime files
serve.log
serve.err

# Editors / OS
.vscode/
.DS_Store
Thumbs.db
